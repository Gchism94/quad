# Cairn environment variables — copy to .env and fill in your values.
# Lines starting with # are comments; all variables are optional unless noted.

# ---------------------------------------------------------------------------
# Store
# ---------------------------------------------------------------------------

# CAIRN_STORE=          # explicit backend: memory | sqlite | postgres
#                      # (auto-selected when unset: postgres if CAIRN_DATABASE_URL
#                      #  is set, otherwise sqlite)

# CAIRN_SQLITE_PATH=    # path to the SQLite database file (default: cairn.db)
#                      # ignored when CAIRN_STORE=postgres or CAIRN_STORE=memory

# CAIRN_DATABASE_URL=   # PostgreSQL DSN (triggers postgres store when CAIRN_STORE is unset)
# example: postgres://cairn:secret@localhost:5432/cairn?sslmode=disable

# CAIRN_DB_AUTOMIGRATE= # set to "1" to apply embedded schema on startup (idempotent)

# ---------------------------------------------------------------------------
# GitHub adapter (optional — enables GitHub-hosted classrooms)
# ---------------------------------------------------------------------------

# CAIRN_GITHUB_APP_ID=          # GitHub App numeric ID
# CAIRN_GITHUB_INSTALLATION_ID= # App installation ID (org-level install)
# CAIRN_GITHUB_PRIVATE_KEY_FILE= # path to the App's PEM private key file
# CAIRN_GITHUB_BASE_URL=        # GHES only: enterprise base URL (e.g. https://ghes.corp.com)

# OAuth (for student enrollment + operator login via GitHub):
# CAIRN_GITHUB_CLIENT_ID=
# CAIRN_GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Forgejo / Gitea adapter (optional — enables Forgejo- AND Gitea-hosted classrooms)
# ---------------------------------------------------------------------------
# Forgejo is a hard fork of Gitea sharing the same /api/v1 surface, so these
# CAIRN_FORGEJO_* vars configure ONE Gitea-family instance that is registered under
# BOTH host values. A classroom then declares host: forgejo or host: gitea — pick
# the label matching your actual server; both route to the instance below.

# CAIRN_FORGEJO_BASE_URL=       # instance root, e.g. https://forgejo.example.org
# CAIRN_FORGEJO_TOKEN=          # personal or admin token (needs org + repo write)
# CAIRN_FORGEJO_GIT_USERNAME=   # git clone username (default: oauth2)

# OAuth (for student enrollment + operator login via Forgejo):
# CAIRN_FORGEJO_OAUTH_CLIENT_ID=
# CAIRN_FORGEJO_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# GitLab adapter (optional — enables GitLab-hosted classrooms; gitlab.com or self-hosted)
# ---------------------------------------------------------------------------
# Namespaces are GitLab groups; assignments are created by forking the template
# project and breaking the fork. HTTPS clone uses oauth2:<token> — oauth2 is the
# username (the opposite of Forgejo).

# CAIRN_GITLAB_BASE_URL=        # instance root (default: https://gitlab.com)
# CAIRN_GITLAB_TOKEN=           # personal access token with the "api" scope
# CAIRN_GITLAB_GIT_USERNAME=    # git clone username (default: oauth2)

# OAuth (for student enrollment + operator login via GitLab; scope read_user):
# CAIRN_GITLAB_OAUTH_CLIENT_ID=
# CAIRN_GITLAB_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# OAuth shared settings
# ---------------------------------------------------------------------------

# CAIRN_OAUTH_REDIRECT_URL=     # e.g. https://your-host/auth/callback
#                              # must match the redirect URI in your OAuth app

# CAIRN_OPERATOR_HOST=          # which host handles operator login: github | forgejo | gitea | gitlab
#                              # (auto-selected when unset: github if configured, else forgejo)

# ---------------------------------------------------------------------------
# Authentication & access control
# ---------------------------------------------------------------------------

# CAIRN_ADMIN_USERS=            # comma-separated Git-host usernames allowed to operate
# example: CAIRN_ADMIN_USERS=alice,bob

# CAIRN_AUTH_DISABLED=          # set to "1" to disable operator auth (dev only, logs a warning)

# CAIRN_COOKIE_SECURE=          # set to "1" to add Secure flag to session cookie (use behind HTTPS)

# ---------------------------------------------------------------------------
# Grading
# ---------------------------------------------------------------------------

# CAIRN_GRADER=                 # grading runner: container | local-exec-unsafe
#                              # (nothing runs student code unless this is set)

# CAIRN_GRADER_RUNTIME=         # container runtime: docker | podman  (default: docker)
# CAIRN_GRADER_IMAGE=           # default container image (specs may override per-test)
# CAIRN_GRADER_ISOLATION=       # kernel boundary: shared (default) | gvisor
#                              # gvisor needs runsc registered with the daemon; if it
#                              # is not, grading REFUSES rather than silently running
#                              # with a weaker boundary. See docs/deploy.md §10.
# Egress policy is NOT set here — each grading spec declares it (limits.network:
# none | restricted), and anything unset fails safe to "none". This variable only
# names the runtime network to attach when a spec asks for "restricted":
# CAIRN_GRADER_RESTRICTED_NETWORK= # e.g. a docker network with an egress proxy
#                              # (unset => "restricted" also falls back to none)
# CAIRN_GRADER_USER=            # uid:gid to run containers as (default: server process uid)

# Git clone tokens used by the grading checkout (never embedded in clone URLs):
# CAIRN_GIT_CLONE_TOKEN=        # GitHub token for private repo clones
# (CAIRN_FORGEJO_TOKEN is reused for Forgejo clones)

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# CAIRN_LISTEN_ADDR=            # listen address (default: :8080)

# CAIRN_WEB_DIR=                # path to built dashboard assets (e.g. web/dist)
#                              # when unset, a plain status page is served at /

# CAIRN_WEBHOOK_BASE_URL=       # public BASE URL of this Cairn instance, e.g.
#                              # https://your-host — Cairn appends /webhooks/<host>
#                              # per repo. Must be reachable BY THE GIT HOST.
#                              # (CAIRN_WEBHOOK_URL is accepted as a deprecated alias.)

# Per-host webhook signing secrets. For GitHub/Gitea/Forgejo the receiver verifies
# an HMAC over the body; for GitLab it compares the X-Gitlab-Token header. A host
# with no secret has its deliveries rejected (404/401). Set the same value in the
# host's webhook config. The Forgejo secret also covers gitea (one Gitea-family
# instance).
# CAIRN_GITHUB_WEBHOOK_SECRET=
# CAIRN_FORGEJO_WEBHOOK_SECRET=
# CAIRN_GITLAB_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Deployment (deploy/docker-compose.yml only — the cairn binary ignores these)
# ---------------------------------------------------------------------------
# Only needed when deploying with Docker Compose. See docs/deploy.md.

# POSTGRES_PASSWORD=            # REQUIRED by the compose stack; generate one with
#                              # `openssl rand -hex 24`. Compose builds
#                              # CAIRN_DATABASE_URL from it, so do not set that
#                              # variable yourself when using compose.

# DOCKER_GID=                   # host docker group id, so the container may use
#                              # the socket for grading without running as root:
#                              #   getent group docker | cut -d: -f3

# CAIRN_WORK_DIR=               # host directory for grading checkouts
#                              # (default: /var/lib/cairn/work). It is bind-mounted
#                              # at the SAME path inside the container, because the
#                              # Docker daemon resolves mount paths on the host.
#                              # Must be writable by uid 1000. `cairn doctor` checks it.

# CAIRN_HTTP_PORT=              # host port to publish (default: 8080)
# CAIRN_HTTP_BIND=              # interface to publish on (default: 0.0.0.0);
#                              # set to 127.0.0.1 when using the tls profile

# CAIRN_DOMAIN=                 # hostname for automatic HTTPS with --profile tls,
#                              # e.g. cairn.example.edu (DNS must already point here)
